+					kvm_gz_record_hvc_error(		\
+						KVM_HOST_SMCCC_FUNC(f), &res); \
+					res.a1 = KVM_HOST_SMCCC_FUNC(f) == \
+						KVM_HOST_SMCCC_FUNC(__kvm_vcpu_run) \
+						? ARM_EXCEPTION_GZ_ERROR : 0; \
+				}					\
+			}						\
+		} else {						\
