new file mode 100644
--- /dev/null
+++ b/arch/arm64/kvm/gz.c
@@ -0,0 +1,254 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Host mapping client for GZ's existing EL2 translation tables. */
+#include <linux/arm-smccc.h>
+#include <linux/init.h>
+#include <linux/kvm_host.h>
+#include <linux/list.h>
+#include <linux/mutex.h>
+#include <linux/slab.h>
+#include <asm/kvm_gz.h>
+#include <asm/kvm_gz_context.h>
+#include <asm/kvm_pgtable.h>
+#include <asm/kvm_mmu.h>
+#include <asm/smp_plat.h>
+#include <asm/virt.h>
+
+bool gz_shared_stage1;
+bool gz_hvc_failed;
+
+void kvm_gz_record_hvc_error(unsigned long fid, const struct arm_smccc_res *res)
+{
+	/* Lost timer/GIC/TLB updates cannot be ignored. Stop further guest
+	 * entries on every CPU; cleanup calls may still restore host state. */
+	WRITE_ONCE(gz_hvc_failed, true);
+	pr_err_ratelimited("KVM: GZ HVC %#lx failed (%ld,%#lx,%#lx,%#lx); guest entry disabled\n",
+		fid, (long)res->a0, res->a1, res->a2, res->a3);
+}
+static bool gz_probed;
+static bool gz_requested;
+static DEFINE_MUTEX(gz_map_lock);
+static LIST_HEAD(gz_mappings);
+static unsigned long gz_private_next = GZ_PT_PRIVATE_BASE;
+static struct gz_kvm_context *gz_host_contexts[GZ_MAX_CPUS];
+extern bool kvm_nvhe_sym(gz_shared_stage1);
+extern struct gz_kvm_context *kvm_nvhe_sym(gz_cpu_contexts)[GZ_MAX_CPUS];
+struct gz_mapping {
+	struct list_head list;
+	unsigned long va, size;
+	phys_addr_t pa;
+	unsigned int prot;
+};
+
+static int __init gz_mode_cfg(char *arg)
+{
+	if (!arg || strcmp(arg, "shared"))
+		return -EINVAL;
+	gz_requested = true;
+	return 0;
+}
+early_param("kvm-arm.gz", gz_mode_cfg);
+
+static void gz_call(unsigned long cmd, unsigned long va, phys_addr_t pa,
+		    unsigned long size, unsigned long prot, struct arm_smccc_res *res)
+{
+	arm_smccc_1_1_hvc(GZ_PT_FID, GZ_PT_MAGIC, cmd, va, pa, size, prot, 0, res);
+}
+
+bool __init kvm_gz_probe(void)
+{
+	struct arm_smccc_res res;
+	if (!gz_requested)
+		return false;
+	if (gz_probed)
+		return kvm_gz_enabled();
+	gz_probed = true;
+	if (is_kernel_in_hyp_mode())
+		return false;
+	gz_call(GZ_PT_QUERY, 0, 0, 0, 0, &res);
+	if (res.a0 != GZ_PT_MAGIC || res.a1 != 1 || res.a2 != 36 ||
+	    (res.a3 & (GZ_PT_SHARED_S1 | GZ_PT_NATIVE_PIN)) !=
+			(GZ_PT_SHARED_S1 | GZ_PT_NATIVE_PIN) ||
+	    (res.a3 & GZ_PT_BRIDGE_BOUND))
+		return false;
+	gz_call(GZ_PT_LAYOUT, 0, 0, 0, 0, &res);
+	if (res.a0 || res.a1 != GZ_PT_LINEAR_BASE ||
+	    res.a2 != GZ_PT_LINEAR_SIZE || res.a3 != GZ_PT_PRIVATE_BASE)
+		return false;
+	gz_shared_stage1 = true;
+	return true;
+}
+
+bool __init kvm_gz_layout_valid(u8 tag_lsb)
+{
+	/* The linear conversion must be injective over all host DRAM. */
+	if (!kvm_gz_probe())
+		return false;
+	if (!tag_lsb || tag_lsb > 34) {
+		gz_shared_stage1 = false;
+		pr_err("KVM: host linear span does not fit the GZ EL2 window\n");
+		return false;
+	}
+	return true;
+}
+
+static unsigned int gz_protection(unsigned int prot)
+{
+	return ((prot & KVM_PGTABLE_PROT_R) ? GZ_PT_R : 0) |
+	       ((prot & KVM_PGTABLE_PROT_W) ? GZ_PT_W : 0) |
+	       ((prot & KVM_PGTABLE_PROT_X) ? GZ_PT_X : 0) |
+	       ((prot & KVM_PGTABLE_PROT_DEVICE) ? GZ_PT_DEVICE : 0);
+}
+
+/* Caller serializes mappings. Record only successfully installed regions. */
+static int gz_map_locked(unsigned long va, phys_addr_t pa, unsigned long size,
+			 unsigned int prot)
+{
+	struct arm_smccc_res res;
+	struct gz_mapping *m;
+	unsigned int perms = gz_protection(prot);
+	if (!size || ((va | pa | size) & ~PAGE_MASK))
+		return -EINVAL;
+	while (size) {
+		unsigned long skip = 0, chunk = min_t(unsigned long, size, SZ_64M);
+		/* Reuse matching existing fragments and map only the uncovered
+		 * intervals. This handles full rodata mappings after hyp rodata. */
+		list_for_each_entry(m, &gz_mappings, list) {
+			if (va >= m->va && va - m->va < m->size) {
+				if (pa != m->pa + va - m->va || perms != m->prot)
+					return -EEXIST;
+				skip = min(size, m->size - (va - m->va));
+				break;
+			}
+			if (m->va > va)
+				chunk = min(chunk, m->va - va);
+		}
+		if (skip) {
+			va += skip; pa += skip; size -= skip;
+			continue;
+		}
+		m = kzalloc(sizeof(*m), GFP_KERNEL);
+		if (!m)
+			return -ENOMEM;
+		gz_call(GZ_PT_MAP, va, pa, chunk, perms, &res);
+		if (res.a0 || res.a1 != va) {
+			kfree(m);
+			return res.a0 ? (long)res.a0 : -EIO;
+		}
+		m->va = va; m->pa = pa; m->size = chunk; m->prot = perms;
+		list_add_tail(&m->list, &gz_mappings);
+		va += chunk; pa += chunk; size -= chunk;
+	}
+	return 0;
+}
+
+int kvm_gz_map(unsigned long va, phys_addr_t pa, unsigned long size, unsigned int prot)
+{
+	int rc;
+	mutex_lock(&gz_map_lock);
+	rc = gz_map_locked(va, pa, size, prot);
+	mutex_unlock(&gz_map_lock);
+	return rc;
+}
+
+int kvm_gz_private_map(phys_addr_t pa, unsigned long size,
+		       unsigned long *va, unsigned int prot)
+{
+	unsigned long offset = offset_in_page(pa), base;
+	int rc;
+	if (!size || size > GZ_PT_PRIVATE_SIZE - offset)
+		return -EINVAL;
+	size = PAGE_ALIGN(size + offset);
+	mutex_lock(&gz_map_lock);
+	base = gz_private_next;
+	if (size > GZ_PT_PRIVATE_BASE + GZ_PT_PRIVATE_SIZE - base)
+		rc = -ENOMEM;
+	else {
+		rc = gz_map_locked(base, pa & PAGE_MASK, size, prot);
+		/* Reserve the address even on partial failure, so no stale
+		 * translation can be handed to an unrelated allocation. */
+		gz_private_next += size;
+		if (!rc)
+			*va = base + offset;
+	}
+	mutex_unlock(&gz_map_lock);
+	return rc;
+}
+
+int kvm_gz_bind(void)
+{
+	struct arm_smccc_res res;
+	extern char kvm_nvhe_sym(__gz_kvm_entry)[];
+	kvm_nvhe_sym(gz_shared_stage1) = true;
+	gz_call(GZ_PT_BIND, kern_hyp_va((unsigned long)kvm_ksym_ref(kvm_nvhe_sym(__gz_kvm_entry))), 0, 0, 0, &res);
+	return (long)res.a0;
+}
+
+int kvm_gz_prepare_cpu(int cpu, unsigned long stack, unsigned long percpu)
+{
+	u64 mpidr = cpu_logical_map(cpu);
+	unsigned int index = (mpidr >> 8) & 255;
+	struct gz_kvm_context *s;
+	unsigned int order = get_order(sizeof(*s));
+	int rc;
+	if (index >= GZ_MAX_CPUS || gz_host_contexts[index])
+		return -EINVAL;
+	s = (void *)__get_free_pages(GFP_KERNEL | __GFP_ZERO, order);
+	if (!s)
+		return -ENOMEM;
+	gz_host_contexts[index] = s;
+	s->stack = stack;
+	s->percpu = percpu;
+	s->mpidr = mpidr;
+	s->configured = 1;
+	rc = create_hyp_mappings(s, (char *)s + (PAGE_SIZE << order), PAGE_HYP);
+	if (rc)
+		return rc;
+	kvm_nvhe_sym(gz_cpu_contexts)[index] = kern_hyp_va(s);
+	return 0;
+}
+
+void kvm_gz_free_contexts(void)
+{
+	unsigned int i;
+	for (i = 0; i < GZ_MAX_CPUS; i++) {
+		if (gz_host_contexts[i])
+			free_pages((unsigned long)gz_host_contexts[i], get_order(sizeof(struct gz_kvm_context)));
+		gz_host_contexts[i] = NULL;
+	}
+}
+
+int kvm_gz_cpu_init(void)
+{
+	struct arm_smccc_res res;
+	if (kvm_gz_hvc_failed())
+		return -EIO;
+	kvm_gz_hvc(&res, 0xc6000000UL, GZ_PT_MAGIC, 1, 0, 0, 0, 0, 0);
+	if (res.a0 || res.a1 != GZ_PT_MAGIC || res.a2 != 1 || res.a3)
+		return -ENODEV;
+	return 0;
+}
+
+int kvm_gz_unmap_all(void)
+{
+	struct arm_smccc_res res;
+	struct gz_mapping *m, *next;
+	int rc = 0;
+	mutex_lock(&gz_map_lock);
+	gz_call(GZ_PT_UNBIND, 0, 0, 0, 0, &res);
+	if (res.a0) {
+		rc = (long)res.a0;
+		goto out;
+	}
+	list_for_each_entry_safe(m, next, &gz_mappings, list) {
+		gz_call(GZ_PT_UNMAP, m->va, 0, m->size, 0, &res);
+		if (res.a0) {
+			rc = (long)res.a0;
+			break;
+		}
+		list_del(&m->list);
+		kfree(m);
+	}
+out:
+	mutex_unlock(&gz_map_lock);
+	return rc;
+}
