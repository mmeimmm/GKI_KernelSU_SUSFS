+	ldr x11, [x9, #GZ_CTX_VBAR]
+	msr vbar_el2, x11
+	isb
+	str xzr, [x9, #GZ_CTX_BUSY]
+	/* x9 is caller-saved and survives the final register restores. */
+	ldp x18, x19, [x9, #0]
+	ldp x20, x21, [x9, #16]
+	ldp x22, x23, [x9, #32]
+	ldp x24, x25, [x9, #48]
+	ldp x26, x27, [x9, #64]
+	ldp x28, x29, [x9, #80]
+	ldr x30, [x9, #96]
+	ldr x11, [x9, #GZ_CTX_DAIF]
+	msr daif, x11
+	ret
+.Lgz_direct:
+	/* AAPCS frame only: no EL2 runtime register or stack-bank switch. */
+	stp x29, x30, [sp, #-32]!
+	stp x19, x20, [sp, #16]
+	mov x29, sp
+	mov x19, x9
+	mov x20, x12
+	bl __gz_direct_control
+	str xzr, [x19, #GZ_CTX_BUSY]
+	mov x12, x20
+	ldp x19, x20, [sp, #16]
+	ldp x29, x30, [sp], #32
+	msr daif, x12
+	ret
+.Lgz_busy:
+	msr daif, x12
+.Lgz_unavailable:
+	mov x9, #-1
+	stp x9, xzr, [x8]
+	stp xzr, xzr, [x8, #16]
+	ret
+SYM_FUNC_END(__gz_kvm_entry)
