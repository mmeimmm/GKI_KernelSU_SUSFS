+#include <linux/kvm_host.h>
+
+struct gz_gic_bank {
+	u64 hcr, vmcr, sre, sre_el1, lr[16];
+	struct vgic_v3_cpu_if aprs;
+};
+struct gz_kvm_context {
+	u64 callee[13], result, daif, spsel, sp0, sp1, tpidr;
+	u64 stack, percpu, mpidr, configured, busy;
+	u64 hcr, cptr, hstr, mdcr, vbar, elr, spsr, esr, far, hpfar;
+	u64 vtcr, vttbr, cnthctl, cntvoff, cnthp_ctl, cnthp_cval;
+	u64 zcr, vsesr, fpexc, pmselr, pmuserenr, sctlr;
+	u64 kvm_cntvoff;
+	bool gic_access, sve, ras, aarch32_fp, pmu, gic_switch, timer_switch;
+	bool vcpu_run, gic_direct;
+	struct gz_gic_bank gz_gic, kvm_gic;
+} __aligned(16);
+
+extern struct gz_kvm_context *gz_cpu_contexts[GZ_MAX_CPUS];
+void __gz_restore_host_stage2(void);
+void __gz_restore_host_traps(void);
+void __gz_flush_vm_context(void);
+#endif
+#endif
diff --git a/arch/arm64/include/asm/kvm_gz_hvc.h b/arch/arm64/include/asm/kvm_gz_hvc.h
new file mode 100644
--- /dev/null
+++ b/arch/arm64/include/asm/kvm_gz_hvc.h
@@ -0,0 +1,36 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef __ARM64_KVM_GZ_HVC_H__
+#define __ARM64_KVM_GZ_HVC_H__
+
+#include <linux/arm-smccc.h>
+#include <asm/kvm_gz.h>
+#include <asm/processor.h>
+
+static __always_inline void __kvm_gz_hvc(const unsigned long args[8],
+				       struct arm_smccc_res *res)
+{
+	/* Probe requires the independently pinned native service. Mapping work
+	 * cannot make this call busy; errors must be reported, never replayed. */
+	arm_smccc_1_1_hvc(args[0], args[1], args[2], args[3],
+			  args[4], args[5], args[6], args[7], res);
+}
+
+/* Capture every argument once, including pointer and side-effect expressions. */
+#define __gz_args_0(...)
+#define __gz_args_1(a) (unsigned long)(a)
+#define __gz_args_2(a, ...) (unsigned long)(a), __gz_args_1(__VA_ARGS__)
+#define __gz_args_3(a, ...) (unsigned long)(a), __gz_args_2(__VA_ARGS__)
+#define __gz_args_4(a, ...) (unsigned long)(a), __gz_args_3(__VA_ARGS__)
+#define __gz_args_5(a, ...) (unsigned long)(a), __gz_args_4(__VA_ARGS__)
+#define __gz_args_6(a, ...) (unsigned long)(a), __gz_args_5(__VA_ARGS__)
+#define __gz_args_7(a, ...) (unsigned long)(a), __gz_args_6(__VA_ARGS__)
+#define ___gz_args(count, ...) __gz_args_ ## count(__VA_ARGS__)
+#define __gz_args(count, ...) ___gz_args(count, __VA_ARGS__)
+#define kvm_gz_hvc(res, fid, ...) \
+	do { \
+		const unsigned long __gz_call_args[8] = { (u32)(fid), \
+			__gz_args(__count_args(fid, ##__VA_ARGS__, res), ##__VA_ARGS__) }; \
+		__kvm_gz_hvc(__gz_call_args, res); \
+	} while (0)
+
+#endif
