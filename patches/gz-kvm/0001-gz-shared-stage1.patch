+	mov x10, #0xc6000000
+	cmp x0, x10
+	b.eq .Lgz_direct
+	add x10, x10, #6
+	cmp x0, x10
+	b.eq .Lgz_direct
+	add x10, x10, #3
+	cmp x0, x10
+	b.lo .Lgz_full
+	add x10, x10, #5
+	cmp x0, x10
+	b.ls .Lgz_direct
+.Lgz_full:
+	stp x18, x19, [x9, #0]
+	stp x20, x21, [x9, #16]
+	stp x22, x23, [x9, #32]
+	stp x24, x25, [x9, #48]
+	stp x26, x27, [x9, #64]
+	stp x28, x29, [x9, #80]
+	str x30, [x9, #96]
+	str x8, [x9, #GZ_CTX_RESULT]
+	str x12, [x9, #GZ_CTX_DAIF]
+	mrs x11, spsel
+	str x11, [x9, #GZ_CTX_SPSEL]
+	/* SP_EL2 cannot be read by MRS at EL2. Select each bank explicitly. */
+	msr spsel, #0
+	mov x11, sp
+	str x11, [x9, #GZ_CTX_SP0]
+	msr spsel, #1
+	mov x11, sp
+	str x11, [x9, #GZ_CTX_SP1]
+	mrs x11, tpidr_el2
+	str x11, [x9, #GZ_CTX_TPIDR]
+	ldr x11, [x9, #GZ_CTX_STACK]
+	mov sp, x11
+	ldr x11, [x9, #GZ_CTX_PERCPU]
+	msr tpidr_el2, x11
+	mov x19, x9
+	stp x0, x1, [sp, #-64]!
+	stp x2, x3, [sp, #16]
+	stp x4, x5, [sp, #32]
+	stp x6, x7, [sp, #48]
+	mov x0, x19
+	/* Only guest/VGIC calls need a GIC bank switch. */
+	ldr x1, [sp]
+	bl __gz_save_system
+	ldp x0, x1, [sp]
+	ldp x2, x3, [sp, #16]
+	ldp x4, x5, [sp, #32]
+	ldp x6, x7, [sp, #48]
+	add sp, sp, #64
+	ldr x8, [x19, #GZ_CTX_RESULT]
+	bl __gz_kvm_dispatch
+	mov x0, x19
+	bl __gz_restore_system
+	mov x9, x19
+	ldr x11, [x9, #GZ_CTX_TPIDR]
+	msr tpidr_el2, x11
+	ldr x11, [x9, #GZ_CTX_SP0]
+	msr spsel, #0
+	mov sp, x11
+	ldr x11, [x9, #GZ_CTX_SP1]
+	msr spsel, #1
+	mov sp, x11
+	ldr x11, [x9, #GZ_CTX_SPSEL]
+	msr spsel, x11
