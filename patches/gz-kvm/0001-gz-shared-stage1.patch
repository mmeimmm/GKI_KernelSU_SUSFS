diff --git a/arch/arm64/kvm/hyp/nvhe/gz-bridge.c b/arch/arm64/kvm/hyp/nvhe/gz-bridge.c
new file mode 100644
--- /dev/null
+++ b/arch/arm64/kvm/hyp/nvhe/gz-bridge.c
@@ -0,0 +1,357 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Run the native KVM backend as a bounded GZ EL2 function call. */
+#include <linux/arm-smccc.h>
+#include <linux/build_bug.h>
+#include <linux/irqchip/arm-gic-v3.h>
+#include <clocksource/arm_arch_timer.h>
+#include <asm/kvm_gz.h>
+#include <asm/kvm_gz_context.h>
+#include <asm/kvm_hyp.h>
+#include <asm/kvm_emulate.h>
+#include <asm/kvm_mmu.h>
+#include <asm/sysreg.h>
+#include <asm/tlbflush.h>
+#include <nvhe/trap_handler.h>
+
+bool gz_shared_stage1;
+struct gz_kvm_context *gz_cpu_contexts[GZ_MAX_CPUS];
+void __gz_handle_host_hcall(struct kvm_cpu_context *);
+
+static struct gz_kvm_context *current_context(void)
+{
+	u64 index = (read_sysreg(mpidr_el1) >> 8) & 255;
+	return gz_cpu_contexts[index]; /* Entry validated full MPIDR and index. */
+}
+
+static u64 get_lr(unsigned int index)
+{
+	switch (index) {
+#define LR_CASE(n) case n: return read_gicreg(ICH_LR##n##_EL2)
+	LR_CASE(0); LR_CASE(1); LR_CASE(2); LR_CASE(3);
+	LR_CASE(4); LR_CASE(5); LR_CASE(6); LR_CASE(7);
+	LR_CASE(8); LR_CASE(9); LR_CASE(10); LR_CASE(11);
+	LR_CASE(12); LR_CASE(13); LR_CASE(14); LR_CASE(15);
+#undef LR_CASE
+	}
+	return 0;
+}
+
+static void set_lr(unsigned int index, u64 value)
+{
+	switch (index) {
+#define LR_CASE(n) case n: write_gicreg(value, ICH_LR##n##_EL2); break
+	LR_CASE(0); LR_CASE(1); LR_CASE(2); LR_CASE(3);
+	LR_CASE(4); LR_CASE(5); LR_CASE(6); LR_CASE(7);
+	LR_CASE(8); LR_CASE(9); LR_CASE(10); LR_CASE(11);
+	LR_CASE(12); LR_CASE(13); LR_CASE(14); LR_CASE(15);
+#undef LR_CASE
+	}
+}
+
+static void save_gic(struct gz_gic_bank *bank)
+{
+	unsigned int i, count = (read_gicreg(ICH_VTR_EL2) & 15) + 1;
+	bank->sre = read_gicreg(ICC_SRE_EL2);
+	bank->sre_el1 = read_gicreg(ICC_SRE_EL1);
+	bank->hcr = read_gicreg(ICH_HCR_EL2);
+	bank->vmcr = read_gicreg(ICH_VMCR_EL2);
+	__vgic_v3_save_aprs(&bank->aprs); /* Gates optional APRs with ICH_VTR. */
+	for (i = 0; i < count; i++)
+		bank->lr[i] = get_lr(i);
+}
+
+static void restore_gic(struct gz_gic_bank *bank)
+{
+	unsigned int i, count = (read_gicreg(ICH_VTR_EL2) & 15) + 1;
+	write_gicreg(0, ICH_HCR_EL2);
+	write_gicreg(bank->sre, ICC_SRE_EL2);
+	isb();
+	write_gicreg(bank->sre_el1, ICC_SRE_EL1);
+	isb();
+	write_gicreg(bank->vmcr, ICH_VMCR_EL2);
+	__vgic_v3_restore_aprs(&bank->aprs);
+	for (i = 0; i < count; i++)
+		set_lr(i, bank->lr[i]);
+	write_gicreg(bank->hcr, ICH_HCR_EL2);
+	isb();
+}
+
+/* Keep CVAL - CNTVCT unchanged when switching counter coordinates. Native
+ * KVM inspects loaded CNTV_CTL.ISTATUS at EL1, where GZ retains host CNTVOFF.
+ * Mask the timer across both writes so an intermediate expired comparator
+ * cannot leave a false pending interrupt in the physical GIC.
+ */
+static void switch_vtimer_offset(u64 offset)
+{
+	u64 previous = read_sysreg(cntvoff_el2);
+	u64 ctl = read_sysreg(cntv_ctl_el0);
+	u64 cval = read_sysreg(cntv_cval_el0);
+
+	write_sysreg(0, cntv_ctl_el0);
+	isb();
+	write_sysreg(offset, cntvoff_el2);
+	write_sysreg(cval + previous - offset, cntv_cval_el0);
+	isb();
+	write_sysreg(ctl, cntv_ctl_el0);
+	isb();
+}
+
+void __gz_save_system(struct gz_kvm_context *s, unsigned long fid)
+{
+	u64 pfr0 = read_sysreg(id_aa64pfr0_el1);
+	u64 dfr0 = read_sysreg(id_aa64dfr0_el1);
+	unsigned long id = fid - 0xc6000000UL;
+	BUILD_BUG_ON(offsetof(struct gz_kvm_context, result) != GZ_CTX_RESULT);
+	BUILD_BUG_ON(offsetof(struct gz_kvm_context, busy) != GZ_CTX_BUSY);
+	BUILD_BUG_ON(offsetof(struct gz_kvm_context, vbar) != GZ_CTX_VBAR);
+#define SAVE(reg) s->reg = read_sysreg(reg##_el2)
+	SAVE(hcr); SAVE(cptr); SAVE(hstr); SAVE(mdcr); SAVE(vbar);
+	SAVE(elr); SAVE(spsr); SAVE(esr); SAVE(far); SAVE(hpfar);
+	SAVE(vtcr); SAVE(vttbr); SAVE(cnthctl); SAVE(cntvoff); SAVE(sctlr);
+	SAVE(cnthp_ctl); SAVE(cnthp_cval);
+#undef SAVE
+	s->sve = ((pfr0 >> 32) & 15) == 1;
+	s->ras = ((pfr0 >> 28) & 15) >= 1 && ((pfr0 >> 28) & 15) < 15;
+	s->aarch32_fp = ((pfr0 >> 4) & 15) == 2 && ((pfr0 >> 16) & 15) != 15;
+	s->pmu = ((dfr0 >> 8) & 15) >= 1 && ((dfr0 >> 8) & 15) < 15;
+	if (s->sve) s->zcr = read_sysreg_s(SYS_ZCR_EL2);
+	if (s->ras) s->vsesr = read_sysreg_s(SYS_VSESR_EL2);
+	if (s->aarch32_fp) s->fpexc = read_sysreg(fpexc32_el2);
+	if (s->pmu) {
+		s->pmselr = read_sysreg(pmselr_el0);
+		s->pmuserenr = read_sysreg(pmuserenr_el0);
+	}
+	s->gic_access = ((pfr0 >> 24) & 15) == 1 &&
+			 (read_gicreg(ICC_SRE_EL2) & ICC_SRE_EL2_SRE);
+	s->gic_switch = s->gic_access && (id == 1 || (id >= 8 && id <= 11) || id == 13 || id == 14);
+	s->timer_switch = id == 1 || id == 6;
+	s->vcpu_run = id == 1;
+	s->gic_direct = s->vcpu_run &&
+		static_branch_unlikely(&kvm_vgic_global_state.gicv3_cpuif);
+	if (s->gic_switch) {
+		save_gic(&s->gz_gic);
+		s->kvm_gic.sre = s->gz_gic.sre;
+		s->kvm_gic.sre_el1 = s->gz_gic.sre_el1;
+		if (s->gic_direct) {
+			/* Native VCPU_RUN installs guest LRs/HCR and the v2 VMCR.
+			 * Supply its lazy APR state and a clean unused-LR baseline,
+			 * without first installing an intermediate KVM GIC bank.
+			 */
+			unsigned int i, count = (read_gicreg(ICH_VTR_EL2) & 15) + 1;
+			write_gicreg(0, ICH_HCR_EL2);
+			isb();
+			for (i = 0; i < count; i++) set_lr(i, 0);
+			/* v3 VMCR is lazy-loaded by the host and is not written by
+			 * __vgic_v3_activate_traps(). Never inherit GZ's VMCR. */
+			write_gicreg(s->kvm_gic.vmcr, ICH_VMCR_EL2);
+			__vgic_v3_restore_aprs(&s->kvm_gic.aprs);
+		} else {
+			restore_gic(&s->kvm_gic);
+		}
+	}
+	if (s->vcpu_run)
+		switch_vtimer_offset(s->kvm_cntvoff);
+	else if (s->timer_switch)
+		write_sysreg(s->kvm_cntvoff, cntvoff_el2);
+	/* Retain the host's stage-2 enable and GZ controls at native guest exit. */
+	this_cpu_ptr(&kvm_init_params)->hcr_el2 = s->hcr;
+}
+
+void __gz_restore_host_stage2(void)
+{
+	struct gz_kvm_context *s = current_context();
+	write_sysreg(s->vtcr, vtcr_el2);
+	write_sysreg(s->vttbr, vttbr_el2);
+	isb();
+}
+
+/* Native guest exit restores the real GZ host trap state directly. */
+void __gz_restore_host_traps(void)
+{
+	struct gz_kvm_context *s = current_context();
+	write_sysreg(s->hstr, hstr_el2);
+	write_sysreg(s->mdcr, mdcr_el2);
+	write_sysreg(s->cptr, cptr_el2);
+	write_sysreg(s->hcr, hcr_el2);
+}
+
+void __gz_restore_system(struct gz_kvm_context *s)
+{
+	/* VCPU_RUN already restored host stage-2 in its native exit path. */
+	if (!s->vcpu_run)
+		__gz_restore_host_stage2();
+	if (s->gic_switch) {
+		if (s->gic_direct) {
+			/* Native exit has saved/cleared the guest LRs. Keep only
+			 * state consumed by the host's lazy VGIC control calls.
+			 */
+			__vgic_v3_save_aprs(&s->kvm_gic.aprs);
+			s->kvm_gic.vmcr = read_gicreg(ICH_VMCR_EL2);
+			s->kvm_gic.hcr = read_gicreg(ICH_HCR_EL2);
+		} else {
+			save_gic(&s->kvm_gic);
+		}
+		restore_gic(&s->gz_gic);
+	}
+	if (s->timer_switch)
+		s->kvm_cntvoff = read_sysreg(cntvoff_el2);
+	write_sysreg(0, cnthp_ctl_el2);
+	write_sysreg(s->cnthp_cval, cnthp_cval_el2);
+	write_sysreg(s->cnthp_ctl, cnthp_ctl_el2);
+#define RESTORE(reg) write_sysreg(s->reg, reg##_el2)
+	RESTORE(cnthctl);
+	if (s->vcpu_run)
+		switch_vtimer_offset(s->cntvoff);
+	else
+		RESTORE(cntvoff);
+	if (!s->vcpu_run) {
+		RESTORE(cptr); RESTORE(hstr); RESTORE(mdcr); RESTORE(hcr);
+	}
+	RESTORE(elr); RESTORE(spsr); RESTORE(esr); RESTORE(far); RESTORE(hpfar);
+	RESTORE(sctlr);
+#undef RESTORE
+	if (s->sve) write_sysreg_s(s->zcr, SYS_ZCR_EL2);
+	if (s->ras) write_sysreg_s(s->vsesr, SYS_VSESR_EL2);
+	if (s->aarch32_fp) write_sysreg(s->fpexc, fpexc32_el2);
+	if (s->pmu) {
+		write_sysreg(s->pmselr, pmselr_el0);
+		write_sysreg(s->pmuserenr, pmuserenr_el0);
+	}
+	isb();
+	/* Assembly restores TPIDR, SP banks, VBAR and finally DAIF. */
+}
+
+struct gz_hcall_result { unsigned long a0, a1, a2, a3; };
+
+/* Run on the existing GZ stack. These operations never install a KVM EL2
+ * environment; guest control state is staged in software until VCPU_RUN.
+ */
+struct gz_hcall_result __gz_direct_control(unsigned long fid, unsigned long a1,
+		unsigned long a2, unsigned long a3, unsigned long a4,
+		unsigned long a5, unsigned long a6, unsigned long a7)
+{
+	struct gz_kvm_context *s = current_context();
+	unsigned long id = fid - 0xc6000000UL;
+	unsigned long value = a1;
+	unsigned int i, count, pre_bits;
+	struct vgic_v3_cpu_if *cpu_if;
+
+	if (id == 0) {
+		u64 pfr0 = read_sysreg(id_aa64pfr0_el1);
+		u64 hcr = read_sysreg(hcr_el2);
+		u64 cnthctl = read_sysreg(cnthctl_el2);
+		if (a1 != GZ_PT_MAGIC || a2 != 1 || a3 || a4 || a5 || a6 || a7 ||
+		    (read_sysreg(tcr_el2) & 63) != 28 || ((pfr0 >> 24) & 15) != 1 ||
+		    !(read_gicreg(ICC_SRE_EL2) & ICC_SRE_EL2_SRE) ||
+		    get_vmid_bits(read_sysreg(id_aa64mmfr1_el1)) != 16 ||
+		    (read_sysreg(vtcr_el2) & VTCR_EL2_VS_16BIT) ||
+		    (cnthctl & (CNTHCTL_EL1PCTEN | CNTHCTL_EL1PCEN)) !=
+				 (CNTHCTL_EL1PCTEN | CNTHCTL_EL1PCEN) ||
+		    (hcr & HCR_E2H) || !(hcr & HCR_VM))
+			return (struct gz_hcall_result){SMCCC_RET_NOT_SUPPORTED, 0, 0, 0};
+		return (struct gz_hcall_result){0, GZ_PT_MAGIC, 1, 0};
+	}
+	if ((id >= 9 && id <= 11) || id == 13 || id == 14) {
+		if (((read_sysreg(id_aa64pfr0_el1) >> 24) & 15) != 1 ||
+		    !(read_gicreg(ICC_SRE_EL2) & ICC_SRE_EL2_SRE))
+			return (struct gz_hcall_result){SMCCC_RET_NOT_SUPPORTED, 0, 0, 0};
+	}
+	switch (id) {
+	case 6:
+		s->kvm_cntvoff = a1;
+		/* EL1 translates a loaded comparator against this retained host
+		 * offset until the next real guest entry.
+		 */
+		value = read_sysreg(cntvoff_el2);
+		break;
+	case 9:
+		value = s->kvm_gic.vmcr;
+		break;
+	case 10:
+		s->kvm_gic.vmcr = (u32)a1;
+		break;
+	case 11:
+		count = (read_gicreg(ICH_VTR_EL2) & 15) + 1;
+		for (i = 0; i < count; i++) s->kvm_gic.lr[i] = 0;
+		break;
+	case 12:
+		value = read_sysreg(mdcr_el2);
+		break;
+	case 13:
+	case 14:
+		cpu_if = kern_hyp_va((struct vgic_v3_cpu_if *)a1);
+		pre_bits = (((u32)read_gicreg(ICH_VTR_EL2) >> 26) & 7) + 1;
+		count = pre_bits == 7 ? 4 : pre_bits == 6 ? 2 : 1;
+		for (i = 0; i < count; i++) {
+			if (id == 13) {
+				cpu_if->vgic_ap0r[i] = s->kvm_gic.aprs.vgic_ap0r[i];
+				cpu_if->vgic_ap1r[i] = s->kvm_gic.aprs.vgic_ap1r[i];
+			} else {
+				s->kvm_gic.aprs.vgic_ap0r[i] = cpu_if->vgic_ap0r[i];
+				s->kvm_gic.aprs.vgic_ap1r[i] = cpu_if->vgic_ap1r[i];
+			}
+		}
+		break;
+	default:
+		return (struct gz_hcall_result){SMCCC_RET_NOT_SUPPORTED, 0, 0, 0};
+	}
+	return (struct gz_hcall_result){0, value, 0, 0};
+}
+
+struct gz_hcall_result __gz_kvm_dispatch(unsigned long fid, unsigned long a1,
+		unsigned long a2, unsigned long a3, unsigned long a4,
+		unsigned long a5, unsigned long a6, unsigned long a7)
+{
+	struct gz_kvm_context *s = current_context();
+	struct kvm_cpu_context *ctxt = &this_cpu_ptr(&kvm_host_data)->host_ctxt;
+	unsigned long id = fid - 0xc6000000UL;
+	if (id == 0) {
+		/* Cooperating CPU handshake. Never calls ___kvm_hyp_init. */
+		if (a1 != GZ_PT_MAGIC || a2 != 1 || a3 || a4 || a5 || a6 || a7 ||
+		    (read_sysreg(tcr_el2) & 63) != 28 || !s->gic_access ||
+		    get_vmid_bits(read_sysreg(id_aa64mmfr1_el1)) != 16 ||
+		    (s->vtcr & VTCR_EL2_VS_16BIT) ||
+		    (s->cnthctl & (CNTHCTL_EL1PCTEN | CNTHCTL_EL1PCEN)) !=
+				 (CNTHCTL_EL1PCTEN | CNTHCTL_EL1PCEN) ||
+		    (s->hcr & HCR_E2H) || !(s->hcr & HCR_VM))
+			return (struct gz_hcall_result){SMCCC_RET_NOT_SUPPORTED, 0, 0, 0};
+		return (struct gz_hcall_result){0, GZ_PT_MAGIC, 1, 0};
+	}
+	if (id < 1 || id > 14 ||
+	    ((id == 1 || (id >= 8 && id <= 11) || id == 13 || id == 14) && !s->gic_access))
+		return (struct gz_hcall_result){SMCCC_RET_NOT_SUPPORTED, 0, 0, 0};
+	cpu_reg(ctxt, 0) = fid; cpu_reg(ctxt, 1) = a1;
+	cpu_reg(ctxt, 2) = a2; cpu_reg(ctxt, 3) = a3;
+	cpu_reg(ctxt, 4) = a4; cpu_reg(ctxt, 5) = a5;
+	cpu_reg(ctxt, 6) = a6; cpu_reg(ctxt, 7) = a7;
+	__gz_handle_host_hcall(ctxt); /* Uses the actual native __kvm_vcpu_run. */
+	if (id == 7 && cpu_reg(ctxt, 0) == SMCCC_RET_SUCCESS)
+		s->sctlr |= SCTLR_ELx_DSSBS;
+	return (struct gz_hcall_result){cpu_reg(ctxt, 0), cpu_reg(ctxt, 1), 0, 0};
+}
+
+void __gz_flush_vm_context(void)
+{
+	unsigned int vmid;
+	u64 tcr = read_sysreg(tcr_el1);
+	u64 vttbr = read_sysreg(vttbr_el2);
+	u64 vtcr = read_sysreg(vtcr_el2);
+	/* KVM owns hardware VMIDs 256..511; GZ's original VS=0 host owns 0..255.
+	 * Never issue the native all-VMID ALLE1IS during KVM rollover. */
+	write_sysreg(tcr | TCR_EPD0_MASK | TCR_EPD1_MASK, tcr_el1);
+	isb();
+	write_sysreg(vtcr | VTCR_EL2_VS_16BIT, vtcr_el2);
+	dsb(ishst);
+	for (vmid = 256; vmid < 512; vmid++) {
+		write_sysreg((vttbr & ~VTTBR_VMID_MASK(16)) | ((u64)vmid << VTTBR_VMID_SHIFT), vttbr_el2);
+		isb();
+		__tlbi(vmalls12e1is);
+		if (icache_is_vpipt()) asm volatile("ic ialluis");
+	}
+	dsb(ish);
+	write_sysreg(vtcr, vtcr_el2);
+	write_sysreg(vttbr, vttbr_el2);
+	isb();
+	write_sysreg(tcr, tcr_el1);
+	isb();
+}
