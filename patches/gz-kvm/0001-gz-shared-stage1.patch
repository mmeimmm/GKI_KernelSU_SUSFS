+/* Assembly prefix: keep offsets checked against C at build time. */
+#define GZ_CTX_RESULT	104
+#define GZ_CTX_DAIF	112
+#define GZ_CTX_SPSEL	120
+#define GZ_CTX_SP0	128
+#define GZ_CTX_SP1	136
+#define GZ_CTX_TPIDR	144
+#define GZ_CTX_STACK	152
+#define GZ_CTX_PERCPU	160
+#define GZ_CTX_MPIDR	168
+#define GZ_CTX_CONFIGURED 176
+#define GZ_CTX_BUSY	184
+#define GZ_CTX_VBAR	224
+#define GZ_MAX_CPUS	8
