--- /dev/null
+++ b/arch/arm64/kvm/hyp/nvhe/gz-entry.S
@@ -0,0 +1,135 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+#include <linux/linkage.h>
+#include <asm/assembler.h>
+#include <asm/kvm_gz_context.h>
+
+/* GZ calls this as an AAPCS64 function, with its 32-byte result buffer in x8.
+ * No takeover HVC, TTBR/TCR/MAIR write or ERET to the host occurs here. */
+SYM_FUNC_START(__gz_kvm_entry)
+	mrs x10, mpidr_el1
+	/* Compare all affinity bits, ignoring MPIDR U/MT/reserved flags. */
+	mov x11, #0xffffff
+	movk x11, #0xff, lsl #32
+	and x10, x10, x11
+	ubfx x11, x10, #8, #8
+	cmp x11, #GZ_MAX_CPUS
+	b.hs .Lgz_unavailable
+	adr_l x9, gz_cpu_contexts
+	ldr x9, [x9, x11, lsl #3]
+	cbz x9, .Lgz_unavailable
+	ldr x11, [x9, #GZ_CTX_MPIDR]
+	cmp x10, x11
+	b.ne .Lgz_unavailable
+	ldr x11, [x9, #GZ_CTX_CONFIGURED]
+	cbz x11, .Lgz_unavailable
+	mrs x12, daif
+	msr daifset, #0xf
+	ldr x11, [x9, #GZ_CTX_BUSY]
+	cbnz x11, .Lgz_busy
+	mov x11, #1
+	str x11, [x9, #GZ_CTX_BUSY]
